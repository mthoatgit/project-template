# Claude Code local settings
.claude/settings.local.json

# IDE / editor
.idea/
.vscode/
*.swp

# OS
.DS_Store
Thumbs.db

# Local API testing tools (e.g. Bruno collections kept out of source control)
bruno/

# Logs
*.log

# --- Stack-specific entries ---

# Python — the orchestrator (bundled at ./orchestrator/) is stdlib-Python,
# and any Python code this project adds picks up the same ignores.
__pycache__/
*.pyc
*.pyo
.venv/
*.egg-info/
dist/
.pytest_cache/

